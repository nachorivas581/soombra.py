  // === FUNCIÓN DE SINCRONIZACIÓN ===
  const syncRemoteStatus = useCallback(async () => {
    try {
      const deviceId = await getDeviceId();
      console.log('[SYNC] Consultando estado para:', deviceId);

      const response = await fetch(`${API_BASE_URL}/check_device.php`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ deviceId }),
      });
      const result = await response.json();
      console.log('[SYNC] Respuesta del servidor:', result);

      if (!result.success) {
        console.log('[SYNC] El servidor respondió con un error.');
        return;
      }

      const remoteStatus = result.status ? result.status.toString().toLowerCase().trim() : 'unknown';
      const remoteExpiration = result.expiration_date ? parseInt(result.expiration_date) : 0;
      const now = Date.now();
      const remoteExpirationMs = remoteExpiration * 1000;

      console.log('[SYNC] Estado normalizado:', remoteStatus, 'Expiración (ms):', remoteExpirationMs);

      // Caso 1: Suspendido, expirado o activo pero vencido
      if (remoteStatus === 'blocked' || remoteStatus === 'expired' || (remoteStatus === 'activated' && remoteExpirationMs < now)) {
        await AsyncStorage.removeItem(ACTIVATION_KEY);
        await AsyncStorage.removeItem(TRIAL_KEY);
        await AsyncStorage.setItem(REVOKED_KEY, 'true');

        const newStatus = await checkAccessStatus();
        setAccessValid(newStatus.valid);
        setAccessDaysLeft(newStatus.daysLeft);
        setAccessExpired(newStatus.expired);
        setIsActivated(newStatus.isActivated);

        if (!newStatus.valid) {
          console.log('[SYNC] Acceso denegado: suscripción revocada o expirada.');
        }
        return;
      }

      // Caso 2: Activo y vigente
      if (remoteStatus === 'activated' && remoteExpirationMs > now) {
        await AsyncStorage.removeItem(REVOKED_KEY);

        const activationRaw = await AsyncStorage.getItem(ACTIVATION_KEY);
        let currentExpiration = null;
        if (activationRaw) {
          try {
            const activation = JSON.parse(activationRaw);
            currentExpiration = activation.expirationDate;
          } catch (e) {
            console.log('[SYNC] Error al parsear activation:', e);
          }
        }

        if (currentExpiration !== remoteExpirationMs) {
          const newActivation: ActivationData = {
            code: 'sync',
            expirationDate: remoteExpirationMs,
          };
          await AsyncStorage.setItem(ACTIVATION_KEY, JSON.stringify(newActivation));

          const newStatus = await checkAccessStatus();
          setAccessValid(newStatus.valid);
          setAccessDaysLeft(newStatus.daysLeft);
          setAccessExpired(newStatus.expired);
          setIsActivated(newStatus.isActivated);

          console.log('[SYNC] Suscripción actualizada correctamente.');
        } else {
          console.log('[SYNC] El estado ya está actualizado.');
        }
        return;
      }

      // Caso 3: Otro estado (desconocido, trial, etc.)
      console.log('[SYNC] Estado actual:', remoteStatus);
    } catch (e) {
      console.error('[SYNC] Error:', e);
    }
  }, []);

