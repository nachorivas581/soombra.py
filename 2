// ============================================================
// REPRODUCTOR MEJORADO CON SIGUIENTE EPISODIO, CUENTA REGRESIVA
// Y SELECTOR NATIVO / WEBVIEW
// ============================================================
const ReproductorMejorado = memo(({
  url,
  onClose,
  title,
  id,
  poster,
  type = 'movie',
  showId,
  showName,
  episodeCode,
  sourceOptions = [],
  selectedSourceIndex = 0,
  onSelectSource,
  initialTime = 0,
  nextEpisode = null,
  onPlayNextEpisode = null,
  autoPlayNext = true,
  audioStreams = [],
  subtitleStreams = [],
}: any) => {
  const [error, setError] = useState<string | null>(null);
  const [loading, setLoading] = useState(true);
  const [isPlaying, setIsPlaying] = useState(true);
  const [currentTime, setCurrentTime] = useState(0);
  const [duration, setDuration] = useState(0);
  const [controlsVisible, setControlsVisible] = useState(true);
  const [savedProgress, setSavedProgress] = useState(0);
  const [sourceModalVisible, setSourceModalVisible] = useState(false);
  const [tracksModalVisible, setTracksModalVisible] = useState(false);
  const [hasSetInitialTime, setHasSetInitialTime] = useState(false);
  const [retryCount, setRetryCount] = useState(0);
  const [isClosing, setIsClosing] = useState(false);
  const [showNextBanner, setShowNextBanner] = useState(false);
  const [countdown, setCountdown] = useState(10);
  const countdownInterval = useRef<NodeJS.Timeout | null>(null);

  // ESTADO PARA SELECCIONAR WEBVIEW
  const [useWebView, setUseWebView] = useState(false);

  useKeepAwake();

  const controlsAnim = useRef(new Animated.Value(1)).current;
  const hideTimeout = useRef<NodeJS.Timeout | null>(null);
  const saveIntervalRef = useRef<NodeJS.Timeout | null>(null);
  const progressTrackRef = useRef<View>(null);

  // Efecto para siguiente episodio
  useEffect(() => {
    if (duration > 0 && currentTime > 0 && duration - currentTime < 3 && duration - currentTime > 0) {
      if (nextEpisode && onPlayNextEpisode && !showNextBanner) {
        setShowNextBanner(true);
        setCountdown(10);
        if (countdownInterval.current) clearInterval(countdownInterval.current);
        countdownInterval.current = setInterval(() => {
          setCountdown(prev => {
            if (prev <= 1) {
              clearInterval(countdownInterval.current!);
              if (autoPlayNext && onPlayNextEpisode) {
                onPlayNextEpisode();
              }
              return 0;
            }
            return prev - 1;
          });
        }, 1000);
      }
    }
  }, [currentTime, duration, nextEpisode, onPlayNextEpisode, autoPlayNext, showNextBanner]);

  useEffect(() => {
    return () => {
      if (countdownInterval.current) clearInterval(countdownInterval.current);
    };
  }, []);

  useEffect(() => {
    setShowNextBanner(false);
    setCountdown(10);
    if (countdownInterval.current) {
      clearInterval(countdownInterval.current);
      countdownInterval.current = null;
    }
  }, [url]);

  useEffect(() => {
    let tvEventHandler: any;
    if (Platform.isTV) {
      tvEventHandler = new TVEventHandler();
      tvEventHandler.enable(this, (cmp: any, evt: any) => {
        if (evt && evt.eventType === 'right') {
          seek(5);
        } else if (evt && evt.eventType === 'left') {
          seek(-5);
        }
      });
    }
    return () => {
      if (tvEventHandler) tvEventHandler.disable();
    };
  }, [duration]);

  useEffect(() => {
    if (!url || !url.startsWith('http')) {
      setError('URL de stream inválida');
      setLoading(false);
    }
  }, [url]);

  // Forzar WebView para embeds, tvenvivo2, playlist.php, stream.php o bixplay.online
  useEffect(() => {
    if (url && (url.includes('embed.saohgdasregions.fun/embed/') ||
                url.includes('tvenvivo2.com') ||
                url.includes('playlist.php') ||
                url.includes('stream.php') ||
                url.includes('bixplay.online'))) {
      console.log('[ReproductorMejorado] Detectado embed, tvenvivo2, playlist, stream.php o BixPlay, usando WebView');
      setUseWebView(true);
    }
  }, [url]);

  // REPRODUCTOR NATIVO
  const player = useVideoPlayer(url && url.startsWith('http') ? url : null, (p) => {
    p.loop = false;
    p.play();
    setIsPlaying(true);
    if (initialTime > 0 && !hasSetInitialTime) {
      p.currentTime = initialTime;
      setCurrentTime(initialTime);
      setHasSetInitialTime(true);
    }
  }, [url]);

  // Pistas de audio / subtítulos
  const { availableAudioTracks } = useEvent(player, 'availableAudioTracksChange', {
    availableAudioTracks: player?.availableAudioTracks || [],
  });
  const { audioTrack } = useEvent(player, 'audioTrackChange', {
    audioTrack: player?.audioTrack,
  });
  const { availableSubtitleTracks } = useEvent(player, 'availableSubtitleTracksChange', {
    availableSubtitleTracks: player?.availableSubtitleTracks || [],
  });
  const { subtitleTrack } = useEvent(player, 'subtitleTrackChange', {
    subtitleTrack: player?.subtitleTrack,
  });

  const appliedDefaultAudio = useRef(false);
  useEffect(() => {
    if (appliedDefaultAudio.current) return;
    if (!availableAudioTracks || availableAudioTracks.length === 0) return;
    appliedDefaultAudio.current = true;
    const plexDefault = (audioStreams || []).find((s: PlexStreamInfo) => s.isDefault);
    let match = null;
    if (plexDefault) {
      match = availableAudioTracks.find((t: any) =>
        (t.language && plexDefault.languageCode && t.language.toLowerCase().startsWith(plexDefault.languageCode.toLowerCase())) ||
        (t.label && plexDefault.title && t.label.toLowerCase().includes(plexDefault.title.toLowerCase()))
      );
    }
    if (match && player) {
      try { player.audioTrack = match; } catch (e) { console.log('[TRACKS] No se pudo fijar audio por defecto', e); }
    }
  }, [availableAudioTracks, audioStreams, player]);

  const handleSelectAudioTrack = useCallback((track: any) => {
    if (!player) return;
    try {
      player.audioTrack = track;
    } catch (e) {
      console.log('[TRACKS] Error al cambiar de audio', e);
      Alert.alert('Idioma', 'No se pudo cambiar el idioma de audio en este dispositivo.');
    }
  }, [player]);

  const handleSelectSubtitleTrack = useCallback((track: any | null) => {
    if (!player) return;
    try {
      player.subtitleTrack = track;
    } catch (e) {
      console.log('[TRACKS] Error al cambiar de subtítulo', e);
      Alert.alert('Subtítulos', 'No se pudieron activar los subtítulos en este dispositivo.');
    }
  }, [player]);

  const hasTrackOptions = (availableAudioTracks && availableAudioTracks.length > 1) || (availableSubtitleTracks && availableSubtitleTracks.length > 0);

  useEffect(() => {
    if (player && initialTime > 0 && !hasSetInitialTime) {
      player.currentTime = initialTime;
      setCurrentTime(initialTime);
      setHasSetInitialTime(true);
    }
  }, [player, initialTime]);

  // Guardar progreso
  useEffect(() => {
    if (!player || !id) return;
    saveIntervalRef.current = setInterval(() => {
      const current = player.currentTime || 0;
      const dur = (player as any).duration || 0;
      if (dur > 0 && current > 5 && Math.abs(current - savedProgress) > 5) {
        setSavedProgress(current);
        saveContinueWatching({
          id: id,
          title: title,
          poster: poster,
          progress: current,
          duration: dur,
          type: type,
          streamUrl: url,
          showId: showId,
          showName: showName,
          episodeCode: episodeCode,
          watchedAt: Date.now(),
        });
      }
    }, 5000);
    return () => {
      if (saveIntervalRef.current) clearInterval(saveIntervalRef.current);
    };
  }, [player, id, savedProgress]);

  // Cierre
  const handleClose = useCallback(() => {
    if (isClosing) return;
    setIsClosing(true);
    console.log('[PLAYER] Cerrando reproductor');
    const current = player.currentTime || 0;
    const dur = (player as any).duration || 0;
    if (dur > 0 && current > 5 && id) {
      saveContinueWatching({
        id: id,
        title: title,
        poster: poster,
        progress: current,
        duration: dur,
        type: type,
        streamUrl: url,
        showId: showId,
        showName: showName,
        episodeCode: episodeCode,
        watchedAt: Date.now(),
      });
    }
    if (countdownInterval.current) clearInterval(countdownInterval.current);
    if (saveIntervalRef.current) clearInterval(saveIntervalRef.current);
    if (hideTimeout.current) clearTimeout(hideTimeout.current);
    try {
      if (player && typeof player.pause === 'function') player.pause();
    } catch (e) {}
    onClose();
  }, [isClosing, player, id, title, poster, type, url, showId, showName, episodeCode, onClose]);

  // Controles
  useEffect(() => {
    if (controlsVisible) {
      if (hideTimeout.current) clearTimeout(hideTimeout.current);
      hideTimeout.current = setTimeout(() => {
        setControlsVisible(false);
        Animated.timing(controlsAnim, { toValue: 0, duration: 300, easing: Easing.out(Easing.ease), useNativeDriver: true }).start();
      }, 3000);
    }
    return () => {
      if (hideTimeout.current) clearTimeout(hideTimeout.current);
    };
  }, [controlsVisible]);

  const showControls = () => {
    setControlsVisible(true);
    Animated.timing(controlsAnim, { toValue: 1, duration: 200, useNativeDriver: true }).start();
  };

  const togglePlay = () => {
    if (player.playing) {
      player.pause();
      setIsPlaying(false);
    } else {
      player.play();
      setIsPlaying(true);
    }
    showControls();
  };

  const seek = (seconds: number) => {
    const newTime = Math.max(0, Math.min(duration, (player.currentTime || 0) + seconds));
    player.currentTime = newTime;
    setCurrentTime(newTime);
    showControls();
  };

  const handleSeekBarPress = (event: any) => {
    if (!progressTrackRef.current || duration <= 0) return;
    progressTrackRef.current.measure((x, y, width, height, pageX, pageY) => {
      if (width === 0) return;
      let locationX = event.nativeEvent?.locationX;
      if (locationX === undefined && event.nativeEvent?.pageX !== undefined) {
        locationX = event.nativeEvent.pageX - pageX;
      }
      if (locationX === undefined) return;
      const progress = Math.max(0, Math.min(1, locationX / width));
      const newTime = progress * duration;
      player.currentTime = newTime;
      setCurrentTime(newTime);
      showControls();
    });
  };

  const handleRetry = () => {
    setError(null);
    setLoading(true);
    setRetryCount(prev => prev + 1);
    if (player) {
      player.replace(url);
    } else {
      setLoading(false);
      setLoading(true);
    }
  };

  const handleNextEpisode = () => {
    if (onPlayNextEpisode) {
      onPlayNextEpisode();
    }
  };

  const cancelAutoNext = () => {
    if (countdownInterval.current) {
      clearInterval(countdownInterval.current);
      countdownInterval.current = null;
    }
    setShowNextBanner(false);
    setCountdown(10);
  };

  // --- CAMBIAR A WEBVIEW ---
  const toggleWebView = useCallback(() => {
    if (useWebView) {
      setUseWebView(false);
      if (player) {
        player.play();
        setIsPlaying(true);
      }
    } else {
      if (player) {
        player.pause();
        setIsPlaying(false);
      }
      setUseWebView(true);
    }
    showControls();
  }, [useWebView, player]);

  // Eventos de reproducción
  useEffect(() => {
    const sub1 = player.addListener('playingChange', (p: any) => {
      const playing = p?.isPlaying ?? p;
      setIsPlaying(!!playing);
      if (playing) setLoading(false);
    });
    const sub2 = player.addListener('statusChange', (p: any) => {
      if (p?.error) {
        console.log('[PLAYER] ERROR', p.error);
        const errorMsg = `Error de reproducción (intento ${retryCount + 1})`;
        if (retryCount < 3) {
          setRetryCount(prev => prev + 1);
          setLoading(true);
          if (player) player.replace(url);
        } else {
          setError(errorMsg + '. Presiona Reintentar.');
        }
        setLoading(false);
      }
    });
    return () => {
      sub1.remove();
      sub2.remove();
    };
  }, [player, retryCount, url]);

  useEffect(() => {
    if (!player) return;
    const interval = setInterval(() => {
      if (!player) return;
      const ct = player.currentTime || 0;
      const dur = (player as any).duration || 0;
      setCurrentTime(ct);
      setDuration(dur);
    }, 200);
    return () => clearInterval(interval);
  }, [player]);

  const formatTime = (secs: number) => {
    if (!secs || isNaN(secs)) return '0:00';
    const h = Math.floor(secs / 3600);
    const m = Math.floor((secs % 3600) / 60);
    const s = Math.floor(secs % 60);
    if (h > 0) return `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    return `${m}:${String(s).padStart(2, '0')}`;
  };

  const progress = duration > 0 ? currentTime / duration : 0;

  useEffect(() => {
    lockLandscape();
    return () => {};
  }, []);

  // Si hay error, mostrar pantalla de error
  if (error) {
    return (
      <Modal visible animationType="fade" statusBarTranslucent onRequestClose={handleClose}>
        <View style={stylesTV.modalFullscreen}>
          <View style={stylesTV.modalError}>
            <Ionicons name="alert-circle-outline" size={rs(80)} color="#ff1744" />
            <Text style={stylesTV.errorText}>{error}</Text>
            <Focusable style={[stylesTV.resumeBtn, stylesTV.resumeBtnPrimary, { marginTop: 20 }]} onPress={handleRetry}>
              <Text style={stylesTV.resumeBtnText}>Reintentar</Text>
            </Focusable>
          </View>
        </View>
      </Modal>
    );
  }

  // --- MODO WEBVIEW (SIN BOTÓN DE CIERRE) ---
  if (useWebView) {
    return (
      <Modal visible animationType="fade" statusBarTranslucent onRequestClose={handleClose}>
        <View style={{ flex: 1, backgroundColor: '#000' }}>
          <WebViewPlayer
            url={url}
            onClose={toggleWebView}
