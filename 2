  const playChannel = useCallback(async (channel: Canal) => {
    console.log('[CHANNEL] Seleccionando', channel.name);
    setCurrentChannel(channel);
    setLoadingChannels(true);

    let opts: { label: string; url: string }[] = [];

    // 1. Construir las opciones de fuentes según el tipo de canal
    if (channel.isRemote || channel.id.startsWith('remote-')) {
      const fuentes = fuentesRemotas.get(channel.id);
      if (fuentes && fuentes.length > 0) {
        opts = fuentes;
      } else if (channel.slug) {
        opts = getSourceOptionsForSlug(channel.slug, channel.category);
      } else {
        opts = [{ label: 'Directo', url: channel.url || '' }];
      }
    } else {
      if (channel.embedSlug) {
        opts = getSourceOptionsForSlug(channel.embedSlug, channel.category);
        if (channel.url && !opts.some(o => o.url === channel.url)) {
          opts.push({ label: 'Directo', url: channel.url });
        }
      } else {
        opts = [{ label: 'Directo', url: channel.url }];
      }
    }

    setSourceOptions(opts);

    // 2. Función para resolver una URL en cadena (solo para URLs que no sean embed ni proxy)
    const resolveWithChain = async (url: string, maxAttempts: number = 5): Promise<string | null> => {
      let currentUrl = url;
      let attempts = 0;
      while (attempts < maxAttempts) {
        try {
          console.log(`[CHAIN] Intento ${attempts + 1} resolviendo:`, currentUrl);
          const resolved = await resolveSingleSource(currentUrl);
          console.log(`[CHAIN] Resuelto:`, resolved);
          // Si es un stream directo, playlist.php, embed o BixPlay, lo devolvemos
          if (resolved.includes('.m3u8') || resolved.includes('.mpd') || resolved.includes('playlist.php') ||
              resolved.includes('embed.saohgdasregions.fun/embed/') ||
              resolved.includes('bixplay.online')) {
            console.log('[CHAIN] Es un stream directo, playlist, embed o BixPlay, devolviendo.');
            return resolved;
          }
          // Si es stream.php, también lo devolvemos (para WebView)
          if (resolved.includes('stream.php')) {
            console.log('[CHAIN] Es stream.php, devolviendo para WebView.');
            return resolved;
          }
          currentUrl = resolved;
          attempts++;
        } catch (err) {
          console.log(`[CHAIN] Error en intento ${attempts + 1}:`, err);
          if (err.message === 'REDIRECT_TO_TVENVIVO2') {
            throw err;
          }
          return null;
        }
      }
      console.log('[CHAIN] Demasiados intentos, falló.');
      return null;
    };

    // 3. Intentar cada fuente en orden
    let success = false;
    for (let i = 0; i < opts.length; i++) {
      const source = opts[i];
      console.log(`[CHANNEL] Intentando fuente ${i + 1}/${opts.length}: ${source.label}`);
      try {
        // Si es un embed o BixPlay, lo usamos directamente sin resolver
        if (source.url.includes('embed.saohgdasregions.fun/embed/') || source.url.includes('bixplay.online')) {
          console.log('[CHANNEL] Es un embed o BixPlay, se usará directamente en WebView.');
          setCurrentUrl(source.url);
          setSelectedSourceIndex(i);
          success = true;
          break;
        }

        // Si no es embed ni proxy, resolvemos con la cadena
        const finalUrl = await resolveWithChain(source.url);
        if (finalUrl) {
          setCurrentUrl(finalUrl);
          setSelectedSourceIndex(i);
          success = true;
          break;
        }
      } catch (err) {
        if (err.message === 'REDIRECT_TO_TVENVIVO2') {
          console.log('[CHANNEL] Redirige a tvenvivo2.com, usando WebView con:', source.url);
          setCurrentUrl(source.url);
          setSelectedSourceIndex(i);
          success = true;
          break;
        }
        console.log(`[CHANNEL] Fuente ${source.label} falló:`, err);
      }
    }

    if (!success) {
      Alert.alert('Error', `No se pudo cargar ningún stream para ${channel.name}.`);
      setCurrentUrl(null);
    }

    setLoadingChannels(false);
  }, [fuentesRemotas]);

