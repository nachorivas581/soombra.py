// Extrae las pistas de audio y subtítulos embebidas en un Part de Plex
function extractStreamsFromPart(part: any): { audioStreams: PlexStreamInfo[]; subtitleStreams: PlexStreamInfo[] } {
  const partAttrs = part.$ || part;
  const streamArr = ensureArray(partAttrs.Stream);
  const audioStreams: PlexStreamInfo[] = [];
  const subtitleStreams: PlexStreamInfo[] = [];

  streamArr.forEach((s: any) => {
    const attrs = s.$ || s;
    const streamType = parseInt(attrs.streamType, 10);
    if (streamType !== 2 && streamType !== 3) return;

    const info: PlexStreamInfo = {
      id: String(attrs.id || ''),
      index: parseInt(attrs.index, 10) || 0,
      streamType,
      codec: attrs.codec || undefined,
      language: cleanText(attrs.language) || undefined,
      languageCode: attrs.languageCode || attrs.languageTag || undefined,
      title: cleanText(attrs.extendedDisplayTitle) || cleanText(attrs.title) || undefined,
      isDefault: attrs.default === '1' || attrs.default === 'true' || attrs.default === true,
      channels: attrs.channels ? parseInt(attrs.channels, 10) : undefined,
      forced: attrs.forced === '1' || attrs.forced === 'true' || attrs.forced === true,
    };

    if (streamType === 2) audioStreams.push(info);
    else subtitleStreams.push(info);
  });

  // Orden estable: la pista marcada como "default" primero
  audioStreams.sort((a, b) => (b.isDefault ? 1 : 0) - (a.isDefault ? 1 : 0));
  subtitleStreams.sort((a, b) => (b.isDefault ? 1 : 0) - (a.isDefault ? 1 : 0));

  return { audioStreams, subtitleStreams };
}

// Devuelve la URL de reproducción DIRECTA (Direct Play, sin transcodificar)
// del archivo original en Plex, junto con la info de sus pistas de audio/subtítulos.
function getPartStreamInfo(video: any): { streamUrl: string; audioStreams: PlexStreamInfo[]; subtitleStreams: PlexStreamInfo[]; container?: string } {
  const mediaArr = ensureArray(video.Media);
  const mediaSorted = [...mediaArr].sort((a, b) => {
    const aAttrs = a.$ || a;
    const bAttrs = b.$ || b;
    return (parseInt(bAttrs.bitrate, 10) || 0) - (parseInt(aAttrs.bitrate, 10) || 0);
  });
  const media = mediaSorted[0];
  if (!media) return { streamUrl: '', audioStreams: [], subtitleStreams: [] };
  const mediaAttrs = media.$ || media;
  const partArr = ensureArray(mediaAttrs.Part);
  const part = partArr[0];
  if (!part) return { streamUrl: '', audioStreams: [], subtitleStreams: [] };
  const partAttrs = part.$ || part;
  const partKey = partAttrs.key || '';
  if (!partKey) return { streamUrl: '', audioStreams: [], subtitleStreams: [] };

  const streamUrl = `${PLEX_BASE_URL}${partKey}?X-Plex-Token=${PLEX_TOKEN}`;
  const { audioStreams, subtitleStreams } = extractStreamsFromPart(part);
  return { streamUrl, audioStreams, subtitleStreams, container: mediaAttrs.container };
}

// Se mantiene por compatibilidad donde solo se necesita la URL
function getPartStreamUrl(video: any): string {
  return getPartStreamInfo(video).streamUrl;
}

