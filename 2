// SISTEMA DE ACTIVACIÓN CON VERIFICACIÓN REMOTA
// ============================================================
const TRIAL_KEY = '@nexus_trial_data';
const ACTIVATION_KEY = '@nexus_activation_data';

async function getDeviceId(): Promise<string> {
  try {
    const id = Device.deviceId;
    if (id) return id;
    let fallbackId = await AsyncStorage.getItem('@nexus_device_fallback_id');
    if (!fallbackId) {
      fallbackId = Math.random().toString(36).substring(2, 10) + Date.now().toString(36);
      await AsyncStorage.setItem('@nexus_device_fallback_id', fallbackId);
    }
    return fallbackId;
  } catch {
    return 'unknown-device';
  }
}

interface TrialData {
  deviceId: string;
  startDate: number;
}

interface ActivationData {
  code: string;
  expirationDate: number;
}

async function checkAccessStatus(): Promise<{ valid: boolean; daysLeft?: number; expired: boolean; isActivated: boolean; activationExpiration?: number }> {
  try {
    const revoked = await AsyncStorage.getItem(REVOKED_KEY);
    if (revoked === 'true') {
      return { valid: false, expired: true, isActivated: false };
    }
    const activationRaw = await AsyncStorage.getItem(ACTIVATION_KEY);
    if (activationRaw) {
      const activation: ActivationData = JSON.parse(activationRaw);
      const now = Date.now();
      if (now < activation.expirationDate) {
        const daysLeft = Math.ceil((activation.expirationDate - now) / (1000 * 60 * 60 * 24));
        return { valid: true, daysLeft, expired: false, isActivated: true, activationExpiration: activation.expirationDate };
      } else {
        await AsyncStorage.setItem(REVOKED_KEY, 'true');
        return { valid: false, expired: true, isActivated: true };
      }
    }
    const raw = await AsyncStorage.getItem(TRIAL_KEY);
    if (!raw) {
      const deviceId = await getDeviceId();
      const data: TrialData = { deviceId, startDate: Date.now() };
      await AsyncStorage.setItem(TRIAL_KEY, JSON.stringify(data));
      return { valid: true, daysLeft: 3, expired: false, isActivated: false };
    }
    const data: TrialData = JSON.parse(raw);
    const elapsed = Date.now() - data.startDate;
    const days = elapsed / (1000 * 60 * 60 * 24);
    if (days >= 3) {
      await AsyncStorage.setItem(REVOKED_KEY, 'true');
      return { valid: false, expired: true, isActivated: false };
    } else {
      const daysLeft = Math.ceil(3 - days);
      return { valid: true, daysLeft, expired: false, isActivated: false };
    }
  } catch (e) {
    console.log('[ACCESS] Error verificando acceso', e);
    return { valid: true, expired: false, isActivated: false };
  }
}

async function activateWithCode(code: string): Promise<{ success: boolean; expirationDate?: number; error?: string }> {
  try {
    const response = await fetch(`${API_BASE_URL}/verify_code.php`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code, deviceId: await getDeviceId() }),
    });
    const result = await response.json();
    if (result.success && result.expirationDate) {
      const activation: ActivationData = {
        code,
        expirationDate: result.expirationDate,
      };
      await AsyncStorage.setItem(ACTIVATION_KEY, JSON.stringify(activation));
      await AsyncStorage.removeItem(REVOKED_KEY);
      return { success: true, expirationDate: result.expirationDate };
    } else {
      return { success: false, error: result.message || 'Código inválido' };
    }
  } catch (e) {
    console.log('[ACTIVATE] Error activando', e);
    return { success: false, error: 'Error de conexión con el servidor' };
  }
}

async function reportTrialToServer(deviceId: string, trialStart: number) {
  try {
    await fetch(`${API_BASE_URL}/report_trial.php`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ deviceId, trialStart }),
    });
  } catch (e) {
    console.log('[REPORT] No se pudo reportar prueba', e);
  }
}

async function checkRemoteStatus(deviceId: string): Promise<{ status: string; expirationDate?: number }> {
  try {
    const response = await fetch(`${API_BASE_URL}/check_device.php`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ deviceId }),
    });
    const result = await response.json();
    if (result.success) {
      return { status: result.status, expirationDate: result.expiration_date };
    }
    return { status: 'unknown' };
  } catch (e) {
    console.log('[REMOTE_STATUS] Error al consultar:', e);
    return { status: 'unknown' };
  }
}

