// ============================================================
// COMPONENTE: REPRODUCTOR EN MINIATURA (TV en vivo)
// CON SELECTOR NATIVO / WEBVIEW Y DETECCIÓN AUTOMÁTICA DE EMBEDS
// ============================================================
const LivePlayerMini = memo(({
  url,
  channel,
  loading,
  onToggleFullscreen,
  onToggleChannelOverlay,
  fullscreen = false,
  sourceOptions = [],
  selectedSourceIndex = 0,
  onSelectSource,
  onSourceError
}: any) => {
  const [isPlaying, setIsPlaying] = useState(true);
  const [controlsVisible, setControlsVisible] = useState(false);
  const controlsAnim = useRef(new Animated.Value(0)).current;
  const hideTimeout = useRef<NodeJS.Timeout | null>(null);
  const [sourceModalVisible, setSourceModalVisible] = useState(false);

  // --- ESTADO PARA SELECCIONAR WEBVIEW ---
  const [useWebView, setUseWebView] = useState(false);

  const messages = [
    "📢 Aviso: Estamos mejorando la calidad del servicio.",
    "🚀 Día a día estamos trabajando para mejorar.",
    "🎬 Pronto más contenido exclusivo.",
    "📡 Disfruta de la mejor programación.",
    "💡 Sugerencias: escríbenos a soporte@nexustv.com",
    "🔥 No te pierdas los estrenos de esta semana.",
  ];
  const [currentMessageIndex, setCurrentMessageIndex] = useState(0);

  useEffect(() => {
    const interval = setInterval(() => {
      setCurrentMessageIndex((prev) => (prev + 1) % messages.length);
    }, 5000);
    return () => clearInterval(interval);
  }, []);

  // Reproductor nativo
  const player = useVideoPlayer(url && url.startsWith('http') && !useWebView ? url : null, (p) => {
    if (url && url.startsWith('http') && !useWebView) {
      p.loop = false;
      p.play();
      setIsPlaying(true);
    }
  }, [url, useWebView]);

  // Efecto para escuchar errores del reproductor nativo
  useEffect(() => {
    if (!player || useWebView) return;
    const sub = player.addListener('statusChange', (p: any) => {
      if (p?.error) {
        console.log('[LIVE-PLAYER] ERROR', p.error);
        if (onSourceError) onSourceError();
      }
    });
    return () => sub.remove();
  }, [player, onSourceError, useWebView]);

  // Forzar WebView para embeds, tvenvivo2, playlist.php, stream.php o bixplay.online
  useEffect(() => {
    if (url && (url.includes('embed.saohgdasregions.fun/embed/') ||
                url.includes('tvenvivo2.com') ||
                url.includes('playlist.php') ||
                url.includes('stream.php') ||
                url.includes('bixplay.online'))) {
      console.log('[LivePlayerMini] Detectado embed, tvenvivo2, playlist, stream.php o BixPlay, usando WebView');
      setUseWebView(true);
    }
  }, [url]);

  // Forzar orientación landscape en fullscreen
  useEffect(() => {
    if (fullscreen) {
      lockLandscape();
    }
  }, [fullscreen]);

  // Ocultar controles automáticamente
  useEffect(() => {
    if (controlsVisible) {
      if (hideTimeout.current) clearTimeout(hideTimeout.current);
      hideTimeout.current = setTimeout(() => {
        setControlsVisible(false);
        Animated.timing(controlsAnim, { toValue: 0, duration: 300, easing: Easing.out(Easing.ease), useNativeDriver: true }).start();
      }, 4000);
    }
    return () => {
      if (hideTimeout.current) clearTimeout(hideTimeout.current);
    };
  }, [controlsVisible]);

  const showControls = () => {
    setControlsVisible(true);
    Animated.timing(controlsAnim, { toValue: 1, duration: 200, useNativeDriver: true }).start();
  };

  const togglePlay = () => {
    if (useWebView) return; // En WebView los controles los maneja el navegador
    if (player.playing) {
      player.pause();
      setIsPlaying(false);
    } else {
      player.play();
      setIsPlaying(true);
    }
    showControls();
  };

  // --- FUNCIÓN PARA CAMBIAR A WEBVIEW (manual) ---
  const toggleWebView = () => {
    if (useWebView) {
      // Volviendo al nativo: pausamos el WebView y reanudamos el nativo
      setUseWebView(false);
      if (player) {
        player.play();
        setIsPlaying(true);
      }
    } else {
      // Cambiando a WebView: pausamos el nativo
      if (player) {
        player.pause();
        setIsPlaying(false);
      }
      setUseWebView(true);
    }
    showControls();
  };

  const showPlayer = !loading && url && url.startsWith('http');

  // --- MODO WEBVIEW (SIN BOTÓN DE CIERRE) ---
  if (useWebView && url) {
    return (
      <View style={{ flex: 1, backgroundColor: '#000' }}>
        <WebViewPlayer
          url={url}
          onClose={toggleWebView}
          title={channel?.name || 'TV en vivo'}
          fullscreen={fullscreen}
        />
      </View>
    );
  }

  // --- MODO REPRODUCTOR NATIVO ---
  return (
    <View style={stylesTV.liveContainer}>
      <View style={{ flex: fullscreen ? 1 : 0.85, backgroundColor: '#000', position: 'relative', overflow: 'hidden' }}>
        {showPlayer ? (
          <>
            <VideoView style={StyleSheet.absoluteFill} player={player} contentFit="fill" nativeControls={false} onTouchStart={showControls} />
            <Animated.View style={[stylesTV.miniControls, { opacity: controlsAnim }]} pointerEvents={controlsVisible ? 'box-none' : 'none'}>
              <LinearGradient colors={['rgba(0,0,0,0.8)', 'transparent', 'rgba(0,0,0,0.8)']} style={StyleSheet.absoluteFill} pointerEvents="none" />
              <View style={stylesTV.miniTopBar}>
                <Text style={stylesTV.miniTitle} numberOfLines={1}>{channel?.name || 'TV en vivo'}</Text>
                <View style={stylesTV.miniActions}>
                  {/* BOTÓN PARA CAMBIAR A WEBVIEW */}
                  <Focusable onPress={toggleWebView} style={[stylesTV.miniBtn, { backgroundColor: 'rgba(0,0,0,0.6)' }]}>
                    <Ionicons name="globe-outline" size={rs(34)} color="#fff" />
                  </Focusable>
                  {sourceOptions.length > 1 && fullscreen && (
                    <Focusable onPress={() => setSourceModalVisible(true)} style={[stylesTV.miniBtn, { backgroundColor: 'rgba(0,0,0,0.6)' }]}>
                      <Ionicons name="radio-outline" size={rs(34)} color="#fff" />
                    </Focusable>
                  )}
                  <Focusable onPress={onToggleFullscreen} style={[stylesTV.miniBtn, { backgroundColor: 'rgba(0,0,0,0.6)' }]}>
                    <Ionicons name={fullscreen ? "contract-outline" : "expand-outline"} size={rs(34)} color="#fff" />
                  </Focusable>
                  <Focusable onPress={onToggleChannelOverlay} style={[stylesTV.miniBtn, { backgroundColor: 'rgba(0,0,0,0.6)' }]}>
                    <Ionicons name="list" size={rs(34)} color="#fff" />
                  </Focusable>
                </View>
              </View>
              <View style={stylesTV.miniCenter}>
                <Focusable style={stylesTV.miniPlayBtn} onPress={togglePlay}>
                  <LinearGradient colors={['#ff1744', '#d50000']} style={stylesTV.miniPlayGradient} start={{ x: 0, y: 0 }} end={{ x: 1, y: 1 }}>
                    <Ionicons name={isPlaying ? 'pause' : 'play'} size={rs(56)} color="#fff" />
                  </LinearGradient>
                </Focusable>
              </View>
            </Animated.View>
            <SourceSelectorModal visible={sourceModalVisible} options={sourceOptions} selectedIndex={selectedSourceIndex} onSelect={onSelectSource} onClose={() => setSourceModalVisible(false)} />
          </>
        ) : (
          <View style={{ flex: 1, justifyContent: 'center', alignItems: 'center', backgroundColor: '#000' }}>
            <ActivityIndicator size="large" color="#ff1744" />
            <Text style={stylesTV.loadingText}>Cargando señal...</Text>
          </View>
        )}
      </View>

      {!fullscreen && (
        <View style={stylesTV.messagesSection}>
          <LinearGradient
            colors={['rgba(10,10,26,0.95)', 'rgba(20,10,30,0.95)']}
            style={StyleSheet.absoluteFill}
            start={{ x: 0, y: 0 }}
            end={{ x: 1, y: 1 }}
          />
          <View style={stylesTV.messagesContainer}>
            <Ionicons name="information-circle-outline" size={rs(36)} color="rgba(255,255,255,0.6)" style={stylesTV.messageIcon} />
            <Text style={stylesTV.messageText} key={currentMessageIndex}>
              {loading ? '🔄 Cargando señal...' : messages[currentMessageIndex]}
            </Text>
          </View>
        </View>
      )}
    </View>
  );
});

// ============================================================
// COMPONENTE: WEBVIEW PLAYER (con soporte para iframe, stream.php y HLS)
// ============================================================
const WebViewPlayer = memo(({ url, onClose, title, fullscreen = false }: { url: string; onClose: () => void; title?: string; fullscreen?: boolean }) => {
  const webViewRef = useRef<WebView>(null);
  const isEmbed = url && url.includes('embed.saohgdasregions.fun/embed/');
  const isStreamPage = url && (url.includes('stream.php') || url.includes('tvenvivo2.com') || url.includes('bixplay.online'));

  useEffect(() => {
    console.log('[WebViewPlayer] Abriendo URL:', url);
    lockLandscape();
    return () => {};
  }, [url]);

  // Script para autoplay y forzar fullscreen
  const injectedJS = `
    (function() {
      // Forzar que el contenido ocupe toda la pantalla
      document.body.style.margin = '0';
      document.body.style.padding = '0';
      document.body.style.overflow = 'hidden';
      var iframe = document.querySelector('iframe');
      if (iframe) {
        iframe.style.width = '100vw';
        iframe.style.height = '100vh';
        iframe.style.border = 'none';
      }

      function findAndPlay() {
        var video = document.querySelector('video');
        if (video) {
          video.muted = true;
          video.play().catch(function(e) {});
          video.click();
          return true;
        }
        var container = document.querySelector('.player-container, #player, .clappr-player, [data-player]');
        if (container) {
          container.click();
          var vid = container.querySelector('video');
          if (vid) {
            vid.muted = true;
            vid.play().catch(function(e) {});
            vid.click();
          }
          return true;
        }
        if (window.player && typeof window.player.play === 'function') {
          window.player.play();
          return true;
        }
        return false;
      }

      var attempts = 0;
      var interval = setInterval(function() {
        if (findAndPlay() || attempts > 20) {
          clearInterval(interval);
        }
        attempts++;
      }, 500);

      window.addEventListener('load', function() {
        setTimeout(findAndPlay, 1000);
        setTimeout(findAndPlay, 3000);
      });

      if (window.MutationObserver) {
        var observer = new MutationObserver(function() {
          findAndPlay();
        });
        observer.observe(document.body, { childList: true, subtree: true });
        setTimeout(function() { observer.disconnect(); }, 10000);
      }
    })();
  `;

  // Si es un embed, generamos un HTML con iframe
  const iframeHtml = `
    <!DOCTYPE html>
    <html>
      <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
        <style>
          * { margin:0; padding:0; }
          html, body { width:100%; height:100%; background:#000; overflow:hidden; }
          #frame-container { width:100vw; height:100vh; border:none; }
          iframe { width:100%; height:100%; border:0; display:block; }
        </style>
      </head>
      <body>
        <div id="frame-container">
          <iframe
            src="${url}"
            frameborder="0"
            allowfullscreen
            allow="autoplay; encrypted-media; fullscreen"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        <script>
          setTimeout(function() {
            var iframe = document.querySelector('iframe');
            if (iframe) {
              try {
                var doc = iframe.contentDocument || iframe.contentWindow.document;
                var video = doc.querySelector('video');
                if (video) {
                  video.muted = true;
                  video.play().catch(function(e) {});
                }
                var container = doc.querySelector('.player-container, #player');
                if (container) container.click();
              } catch(e) {}
            }
          }, 3000);
        <\/script>
      </body>
    </html>
  `;

  // Si es stream.php o BixPlay, cargamos directamente con headers
  const streamSource = {
    uri: url,
    headers: {
      Referer: 'https://embed.saohgdasregions.fun/',
      'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
    }
  };

  // Si no es embed ni streamPage, usamos el reproductor HLS
  const hlsHtml = `
    <!DOCTYPE html>
    <html>
    <head>
      <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
      <style>
        body { margin: 0; background: #000; display: flex; justify-content: center; align-items: center; height: 100vh; overflow: hidden; }
        video { width: 100%; height: 100%; object-fit: contain; background: #000; }
      </style>
    </head>
    <body>
      <video id="video" controls autoplay playsinline></video>
      <script src="https://cdn.jsdelivr.net/npm/hls.js@0.14.17/dist/hls.min.js"><\/script>
      <script>
        (function() {
          var video = document.getElementById('video');
          var streamUrl = '${url}';
          if (Hls.isSupported()) {
            var hls = new Hls({ enableWorker: true, lowLatencyMode: true });
            hls.loadSource(streamUrl);
            hls.attachMedia(video);
            hls.on(Hls.Events.MANIFEST_PARSED, function() {
              video.play().catch(function(e) { console.log('Autoplay blocked', e); });
            });
            hls.on(Hls.Events.ERROR, function(event, data) {
              if (data.fatal) { console.log('HLS Fatal Error', data); }
            });
          } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
            video.src = streamUrl;
            video.addEventListener('loadedmetadata', function() { video.play(); });
          } else {
            document.body.innerHTML = 'Reproductor no soportado.';
          }
        })();
      <\/script>
    </body>
    </html>
  `;

  let source;
  if (isEmbed) {
    source = { html: iframeHtml };
  } else if (isStreamPage) {
    source = streamSource;
  } else {
    source = { html: hlsHtml };
  }

  return (
    <View style={{ flex: 1, backgroundColor: '#000' }}>
      <WebView
        ref={webViewRef}
        originWhitelist={['*']}
        source={source}
        style={{ flex: 1, backgroundColor: '#000' }}
        mediaPlaybackRequiresUserAction={false}
        allowsInlineMediaPlayback
        allowsFullscreenVideo
        javaScriptEnabled
        domStorageEnabled
        mixedContentMode="always"
        userAgent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        injectedJavaScript={isStreamPage ? injectedJS : undefined}
        onLoadEnd={() => {
          if (isStreamPage && webViewRef.current) {
            setTimeout(() => {
              webViewRef.current?.injectJavaScript(injectedJS);
            }, 500);
          }
        }}
        onError={(e) => console.log('[WebViewPlayer] Error:', e.nativeEvent)}
      />
      {/* Botón de cierre ELIMINADO - solo se cierra con el botón de atrás */}
    </View>
  );
});

