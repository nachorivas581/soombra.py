// DETALLE DE SERIE MEJORADO CON PESTAÑAS POR TEMPORADA
// ============================================================
const SeriesDetail = memo(({
  show,
  onBack,
  onPlayEpisode,
  continueWatchingItems = [],
  onPlayNextEpisode
}: {
  show: PlexShow;
  onBack: () => void;
  onPlayEpisode: (ep: PlexEpisode) => void;
  continueWatchingItems?: ContinueWatchingItem[];
  onPlayNextEpisode?: (ep: PlexEpisode) => void;
}) => {
  const [selectedSeasonIndex, setSelectedSeasonIndex] = useState(0);
  const seasons = show.seasons || [];

  // Obtener el próximo episodio no visto (global)
  const getNextEpisode = useCallback(() => {
    const allEpisodes = seasons.flatMap(s => s.episodes);
    const watchedIds = new Set(
      continueWatchingItems
        .filter(item => item.showId === show.id && item.progress > 0)
        .map(item => item.id)
    );
    return allEpisodes.find(ep => !watchedIds.has(ep.id));
  }, [show, continueWatchingItems, seasons]);

  const nextEpisode = getNextEpisode();

  // Episodios de la temporada seleccionada
  const currentSeason = seasons[selectedSeasonIndex];
  const episodes = currentSeason?.episodes || [];

  const renderEpisode = ({ item: ep, index }: { item: PlexEpisode; index: number }) => {
    const watchedItem = continueWatchingItems.find(
      item => item.id === ep.id && item.showId === show.id
    );
    const progress = watchedItem ? (watchedItem.progress / watchedItem.duration) * 100 : 0;
    const isWatched = progress > 90;

    return (
      <Focusable
        style={stylesTV.detailEpisodeRow}
        onPress={() => onPlayEpisode(ep)}
        hasTVPreferredFocus={index === 0 && selectedSeasonIndex === 0}
      >
        <View style={stylesTV.detailEpisodeCodeBox}>
          <Text style={stylesTV.detailEpisodeCode}>{ep.code}</Text>
        </View>
        <Text style={[stylesTV.detailEpisodeTitle, isWatched && { color: 'rgba(255,255,255,0.4)' }]} numberOfLines={1}>
          {ep.title}
        </Text>
        {isWatched ? (
          <Ionicons name="checkmark-circle" size={rs(30)} color="#4CAF50" />
        ) : progress > 0 ? (
          <View style={{ width: rs(60), height: rs(6), backgroundColor: 'rgba(255,255,255,0.2)', borderRadius: 3, marginHorizontal: 8 }}>
            <View style={{ width: `${Math.min(progress, 100)}%`, height: '100%', backgroundColor: '#ff1744', borderRadius: 3 }} />
          </View>
        ) : (
          <Ionicons name="play-circle-outline" size={rs(34)} color="rgba(255,255,255,0.6)" />
        )}
      </Focusable>
    );
  };

  return (
    <View style={stylesTV.gridContainer}>
      <Focusable style={stylesTV.detailBackBtn} onPress={onBack}>
        <Ionicons name="chevron-back" size={rs(34)} color="#fff" />
        <Text style={stylesTV.detailBackText} numberOfLines={1}>{show.title}</Text>
      </Focusable>

      {show.overview ? (
        <Text style={stylesTV.detailOverview} numberOfLines={3}>{show.overview}</Text>
      ) : null}

      {nextEpisode && onPlayNextEpisode && (
        <Focusable
          style={[stylesTV.resumeBtn, stylesTV.resumeBtnPrimary, { marginBottom: 20, alignSelf: 'center' }]}
          onPress={() => onPlayNextEpisode(nextEpisode)}
        >
          <Ionicons name="play-forward" size={rs(28)} color="#fff" />
          <Text style={stylesTV.resumeBtnText}>Siguiente episodio: {nextEpisode.code}</Text>
        </Focusable>
      )}

      {/* PESTAÑAS DE TEMPORADAS */}
      {seasons.length > 1 && (
        <View style={stylesTV.seasonTabsContainer}>
          {seasons.map((season, idx) => (
            <Focusable
              key={season.number}
              style={[stylesTV.seasonTab, selectedSeasonIndex === idx && stylesTV.seasonTabActive]}
              onPress={() => setSelectedSeasonIndex(idx)}
              hasTVPreferredFocus={idx === 0}
            >
              <Text style={[stylesTV.seasonTabText, selectedSeasonIndex === idx && stylesTV.seasonTabTextActive]}>
                {season.label || `Temporada ${season.number}`}
              </Text>
              {selectedSeasonIndex === idx && <View style={stylesTV.seasonTabIndicator} />}
            </Focusable>
          ))}
        </View>
      )}

      {/* EPISODIOS DE LA TEMPORADA SELECCIONADA */}
      {episodes.length === 0 ? (
        <View style={stylesTV.centerLoading}>
          <Text style={stylesTV.loadingText}>No hay episodios en esta temporada.</Text>
        </View>
      ) : (
        <FlatList
          data={episodes}
          keyExtractor={(ep, idx) => ep.id || `ep-${idx}`}
          renderItem={renderEpisode}
          contentContainerStyle={{ paddingBottom: rs(40) }}
          showsVerticalScrollIndicator={false}
        />
      )}
    </View>
  );
});

