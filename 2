// ============================================================
interface ActivationModalProps {
  visible: boolean;
  onClose: () => void;
  onActivateSuccess: () => void;
  mode?: 'expired' | 'voluntary' | 'renew';
  deviceId?: string;
}

const ActivationModal = memo(({ visible, onClose, onActivateSuccess, mode = 'voluntary', deviceId = '' }: ActivationModalProps) => {
  const [code, setCode] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  const handleActivate = async () => {
    if (!code.trim()) {
      setError('Ingresa un código de activación');
      return;
    }
    setLoading(true);
    setError('');
    const result = await activateWithCode(code.trim());
    setLoading(false);
    if (result.success) {
      Alert.alert('¡Éxito!', 'Tu suscripción ha sido activada correctamente.');
      onActivateSuccess();
    } else {
      setError(result.error || 'Código inválido');
    }
  };

  const openPaymentLink = () => {
    Linking.openURL(PAYMENT_URL).catch(() => Alert.alert('Error', 'No se pudo abrir el enlace de pago'));
  };

  const isExpired = mode === 'expired';
  const isRenew = mode === 'renew';

  return (
    <Modal transparent visible={visible} animationType="fade" onRequestClose={onClose}>
      <TouchableOpacity style={stylesTV.sourceModalOverlay} activeOpacity={1} onPress={onClose}>
        <View style={stylesTV.trialExpiredContent}>
          <Ionicons name={isExpired ? "lock-closed" : "key-outline"} size={rs(80)} color={isExpired ? "#ff1744" : "#4CAF50"} />
          <Text style={[stylesTV.trialExpiredTitle, { color: isExpired ? '#ff1744' : (isRenew ? '#FF9800' : '#4CAF50') }]}>
            {isExpired ? 'Prueba gratuita finalizada' : isRenew ? 'Renovar suscripción' : 'Activar dispositivo'}
          </Text>
          <Text style={stylesTV.trialExpiredSubtitle}>
            {isExpired
              ? 'El periodo de prueba finalizo. Para seguir disfrutando de NEXUS TV, adquiere tu suscripción.'
              : isRenew
              ? 'Tu suscripción está por expirar. Ingresa un nuevo código para extenderla 30 días más.'
              : 'Si ya has adquirido tu suscripción, ingresa el código de activación que recibiste.'}
          </Text>
          {/* Mostrar ID del dispositivo */}
          <Text style={[stylesTV.trialExpiredSubtitle, { color: 'rgba(255,255,255,0.5)', fontSize: rs(16), marginTop: 4 }]}>
            ID del dispositivo: {deviceId || 'No disponible'}
          </Text>
          <View style={stylesTV.trialExpiredActions}>
            {isExpired && (
              <Focusable style={[stylesTV.resumeBtn, stylesTV.resumeBtnPrimary]} onPress={openPaymentLink}>
                <Ionicons name="card-outline" size={rs(28)} color="#fff" />
                <Text style={stylesTV.resumeBtnText}>Comprar suscripción</Text>
              </Focusable>
            )}
            {(isRenew) && (
              <Focusable style={[stylesTV.resumeBtn, { backgroundColor: '#FF9800', borderColor: '#FF9800' }]} onPress={openPaymentLink}>
                <Ionicons name="card-outline" size={rs(28)} color="#fff" />
                <Text style={stylesTV.resumeBtnText}>Renovar ahora</Text>
              </Focusable>
            )}
            <View style={stylesTV.trialActivationForm}>
              <Text style={stylesTV.trialActivationLabel}>
                {isExpired ? '¿Ya tienes un código?' : (isRenew ? 'Ingresa tu nuevo código' : 'Código de activación')}
              </Text>
              <TextInput
                style={stylesTV.trialActivationInput}
                placeholder="Código de activación"
                placeholderTextColor="rgba(255,255,255,0.4)"
                value={code}
                onChangeText={setCode}
                onSubmitEditing={handleActivate}
                autoFocus={!isTV}
              />
              {error ? <Text style={stylesTV.trialError}>{error}</Text> : null}
              <Focusable style={[stylesTV.resumeBtn, stylesTV.resumeBtnPrimary]} onPress={handleActivate}>
                {loading ? (
                  <ActivityIndicator color="#fff" size="small" />
                ) : (
                  <>
                    <Ionicons name="checkmark-circle-outline" size={rs(28)} color="#fff" />
                    <Text style={stylesTV.resumeBtnText}>
                      {isExpired ? 'Activar' : (isRenew ? 'Renovar' : 'Activar')}
                    </Text>
                  </>
                )}
              </Focusable>
              {!isExpired && (
                <Focusable style={[stylesTV.resumeBtn, stylesTV.resumeBtnSecondary, { marginTop: 8 }]} onPress={onClose}>
                  <Text style={stylesTV.resumeBtnText}>Cancelar</Text>
                </Focusable>
              )}
            </View>
          </View>
        </View>
      </TouchableOpacity>
    </Modal>
  );
});

