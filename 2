    const resolveWithChain = async (url: string, maxAttempts: number = 5): Promise<string | null> => {
      let currentUrl = url;
      let attempts = 0;
      while (attempts < maxAttempts) {
        try {
          console.log(`[SOURCE-CHAIN] Intento ${attempts + 1} resolviendo:`, currentUrl);
          const resolved = await resolveSingleSource(currentUrl);
          console.log(`[SOURCE-CHAIN] Resuelto:`, resolved);
          if (resolved.includes('.m3u8') || resolved.includes('.mpd') || resolved.includes('playlist.php') ||
              resolved.includes('embed.saohgdasregions.fun/embed/') ||
              resolved.includes('bixplay.online')) {
            return resolved;
          }
          if (resolved.includes('stream.php')) {
            return resolved;
          }
          currentUrl = resolved;
          attempts++;
        } catch (err) {
          console.log(`[SOURCE-CHAIN] Error en intento ${attempts + 1}:`, err);
          if (err.message === 'REDIRECT_TO_TVENVIVO2') {
            throw err;
          }
          return null;
        }
      }
      return null;
    };

    let success = false;
    // Intentar desde el índice seleccionado, y luego circular
    for (let i = 0; i < opts.length; i++) {
      const idx = (index + i) % opts.length;
      const source = opts[idx];
      try {
        // Si es un embed o BixPlay, lo usamos directamente
        if (source.url.includes('embed.saohgdasregions.fun/embed/') || source.url.includes('bixplay.online')) {
