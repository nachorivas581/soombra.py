  const doramasLoaded = useRef(false);

  useKeepAwake();

  useEffect(() => {
    lockLandscape();
  }, []);

  // ===== FUNCIÓN PARA CARGAR CANALES DESDE EL SERVIDOR =====
  const cargarCanalesDesdeServidor = useCallback(async (mostrarAlerta: boolean = false) => {
    try {
      console.log('[CANALES] Cargando canales remotos...');
      const response = await fetch(`${API_BASE_URL}/get_channels.php`);
      const data = await response.json();
      if (data.success && data.canales) {
        const canalesFormateados: Canal[] = data.canales.map((c: any) => ({
          id: `remote-${c.id}`,
          numero: c.numero || c.id,
          name: c.nombre,
          logo: c.logo || '',
          category: c.categoria || 'General',
          nowPlaying: c.now_playing || '',
          slug: c.slug,
          url: '',
          embedSlug: c.slug,
          isRemote: true,
        }));
        const fuentesMap = new Map();
        data.canales.forEach((c: any) => {
          if (c.fuentes && c.fuentes.length > 0) {
            fuentesMap.set(`remote-${c.id}`, c.fuentes.map((f: any) => ({ label: f.label, url: f.url })));
          }
        });
        setFuentesRemotas(fuentesMap);
        setListaCanales([...canalesFormateados, ...CANALES_MANUALES]);
        if (mostrarAlerta) {
          Alert.alert('Canales actualizados', `Se cargaron ${canalesFormateados.length} canales desde el servidor.`);
        }
        return canalesFormateados;
      } else {
        setListaCanales(CANALES_MANUALES);
        if (mostrarAlerta) {
          Alert.alert('Error', 'No se pudieron cargar los canales remotos. Usando lista local.');
        }
        return [];
      }
    } catch (e) {
      console.log('[CANALES] Error cargando canales remotos', e);
