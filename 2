// --- Escalado responsivo ---
const BASE_WIDTH = 1280;
const MIN_SCALE = 0.55;
const rawScale = W / BASE_WIDTH;
const SCALE = Math.max(MIN_SCALE, Math.min(1, rawScale));

function rs(size: number): number {
  return Math.round(size * SCALE);
}

function getGridColumns(): number {
  if (W < 480) return 2;
  if (W < 800) return 3;
  if (W < 1100) return 4;
  return 6;
}

function getGridItemWidth(): string {
  const cols = getGridColumns();
  const gapPercent = 2;
  const width = (100 - gapPercent * (cols - 1)) / cols;
  return `${width}%`;
}

